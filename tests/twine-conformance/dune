; Conformance test of twine decoders
; Not part of runtest: it needs an adapter

(executable
 (name twine_conformance)
 (libraries
  imandrakit.twine
  imandrax-api
  zarith
  containers
  qcheck-core
  qcheck-core.runner
  unix))

(rule
 (alias twine-conformance)
 (deps
  (env_var TWINE_CONFORMANCE_DECODER)
  (env_var TWINE_CONFORMANCE_COUNT)
  (env_var QCHECK_SEED))
 (action
  (run %{exe:twine_conformance.exe})))
