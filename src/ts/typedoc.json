{
  "$schema": "https://typedoc-plugin-markdown.org/schema.json",
  "entryPoints": ["lib/index.ts"],
  "tsconfig": "tsconfig.build.json",
  "plugin": ["typedoc-plugin-markdown"],
  "outputs": [{ "name": "markdown", "path": "docs/api" }],
  "readme": "README.md",
  "mergeReadme": true,
  "excludePrivate": true,
  "excludeInternal": true
}
